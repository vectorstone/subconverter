DATABASE_URL=postgresql://subconverter:change-me@subconverter-postgres:5432/subconverter
POSTGRES_USER=subconverter
POSTGRES_PASSWORD=change-me
POSTGRES_DB=subconverter
API_TOKEN=replace-with-openssl-rand-base64-32
SHORTLINK_ENCRYPTION_KEY=replace-with-a-long-random-secret
PUBLIC_BASE_URL=https://hi.example.com
SHORTLINK_TRUST_ACCESS_HEADER=false
SHORTLINK_ADMIN_SUBJECTS=admin@example.com
SHORTLINK_MAX_ACTIVE=100
SHORTLINK_MAX_PER_HOUR=20
SHORTLINK_MAX_OUTPUT_BYTES=16777216
SHORTLINK_CLASH_CONFIG=config/default_clash_lite.ini
# Default sing-box platform when the API/UI does not send one (macos|windows|linux|android|ios|openwrt)
SHORTLINK_SINGBOX_PLATFORM=macos
# Preferred landing of the sing-box traffic selector: a group tag or a node remark
# (case-insensitive substring is accepted when it matches exactly one member).
# Resolved against the selector's current members; a value that matches nothing is
# ignored with a warning. Leave empty to keep the implicit first member (auto).
SHORTLINK_SINGBOX_DEFAULT=
# Comma separated remark keywords restricting the members of the `auto` urltest
# group (e.g. "self-hosted,hk,jp"). Matching is case-insensitive substring, so use
# distinctive keywords: "ss" also matches "vless". Leave empty to keep every node.
SHORTLINK_SINGBOX_AUTO_INCLUDE=
SHORTLINK_CLASH_EXPAND=false
SHORTLINK_LITE_MAX_OUTPUT_BYTES=262144
